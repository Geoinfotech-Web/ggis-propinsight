# Production web image: Vite build + nginx (SPA + /v1 API proxy).
# Build from repo root: docker build -f apps/web/Dockerfile.prod -t aia-web-prod .
FROM node:20-slim AS build

WORKDIR /repo

COPY apps/web/package.json apps/web/package-lock.json* apps/web/
RUN cd apps/web && npm ci

COPY design /repo/design
COPY apps/web /repo/apps/web

WORKDIR /repo/apps/web

ARG VITE_3D_TERRAIN_ENABLED=false
ARG VITE_TERRAIN_TILEJSON_URL=https://tiles.mapterhorn.com/tilejson.json
ARG VITE_TERRAIN_ENCODING=terrarium
ARG VITE_TERRAIN_TILE_SIZE=512
ARG VITE_BUILDINGS_TILEJSON_URL=https://tiles.openfreemap.org/planet
ARG VITE_CESIUM_ION_TOKEN=

ENV VITE_3D_TERRAIN_ENABLED=$VITE_3D_TERRAIN_ENABLED \
    VITE_TERRAIN_TILEJSON_URL=$VITE_TERRAIN_TILEJSON_URL \
    VITE_TERRAIN_ENCODING=$VITE_TERRAIN_ENCODING \
    VITE_TERRAIN_TILE_SIZE=$VITE_TERRAIN_TILE_SIZE \
    VITE_BUILDINGS_TILEJSON_URL=$VITE_BUILDINGS_TILEJSON_URL \
    VITE_CESIUM_ION_TOKEN=$VITE_CESIUM_ION_TOKEN

RUN npm run build

FROM nginx:1.27-alpine

COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1
