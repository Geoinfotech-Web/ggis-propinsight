# ============================================================
# GGIS PropInsight (AIA) — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- API app ----
AIA_ENV=dev
AIA_API_PORT=8000
AIA_LOG_LEVEL=INFO

# ---- PostGIS ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=propinsight
POSTGRES_USER=aia
POSTGRES_PASSWORD=change-me-in-local-env
# SQLAlchemy async URL (built from the above by config.py; override only if needed)
# DATABASE_URL=postgresql+asyncpg://aia:change-me@db:5432/propinsight

# ---- Redis (cache + Celery broker) ----
REDIS_URL=redis://redis:6379/0

# ---- GGIS Flood Watch API integration (Section 5, TDD) ----
# Base URL of the GGIS Flood Watch service. Use the mock for local dev:
GGIS_FLOOD_BASE_URL=http://mock-ggis:9100
# Use `live` only when the endpoint above is a verified production source.
GGIS_FLOOD_DATA_MODE=mock
# Service-to-service credentials (HMAC request signing over TLS).
# The real API key is READY — put it in your local .env, not here.
GGIS_FLOOD_API_KEY=replace-with-real-key-in-local-env
GGIS_FLOOD_HMAC_SECRET=replace-with-real-hmac-secret-in-local-env
# Contractual latency budget (ms) before we treat GGIS as degraded (TDD §10)
GGIS_FLOOD_TIMEOUT_MS=800

# ---- POI data sources (ETL: multi-source amenity ingestion) ----
# Comma-separated open providers to ingest. Not limited to OSM.
#   overpass = OpenStreetMap (Overpass API, ODbL)
#   overture = Overture Maps Places (mixed upstream licenses; attribution, non-OSM)
#   grid3    = GRID3 Nigeria facilities via ArcGIS (non-OSM; set URLs below)
POI_SOURCES=overpass,overture,grid3
# Current release from Overture's live STAC catalog (verify before each refresh).
OVERTURE_RELEASE=2026-07-22.0
# Public GRID3 Nigeria ArcGIS FeatureServer layer URLs (source attribution required).
GRID3_HEALTH_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/GRID3_NGA_health_facilities_v2_0/FeatureServer/0
GRID3_EDUCATION_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/Schools_in_Nigeria/FeatureServer/0
GRID3_WARDS_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/GRID3_NGA_operational_wards_v3_0/FeatureServer/0

# Wall-to-wall observed cover: auto | dynamic_world | esa_worldcover.
LAND_COVER_SOURCE=auto
LAND_COVER_SCALE_M=30

# ---- Environmental / outlook rasters ----
# Earth Engine is the primary non-flood source. Set direct only for the explicit
# download fallback below; auto falls back when Earth Engine is unavailable.
ENVIRONMENT_SOURCE=gee
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_DEM_COLLECTION=cop-dem-glo-30-dged-cog
# Public mirror of the authoritative USGS Collection 2 archive. Assets receive
# short-lived read-only signatures from Planetary Computer during ingestion.
USGS_LANDSAT_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
USGS_LANDSAT_ST_COLLECTION=landsat-c2-l2
PLANETARY_COMPUTER_SIGN_URL=https://planetarycomputer.microsoft.com/api/sas/v1/sign
WORLDPOP_2025_URL=https://data.worldpop.org/repo/wopr/NGA/population/v3.0/NGA_population_v3_0_gridded.zip
# WorldPop provides the 2025 spatial baseline. GHSL supplies the 2025–2030
# projected growth ratio; the pipeline never relabels the 2025 raster as 2030.
GHSL_POPULATION_2025_URL=https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_POP_GLOBE_R2023A/GHS_POP_E2025_GLOBE_R2023A_54009_100/V1-0/tiles/GHS_POP_E2025_GLOBE_R2023A_54009_100_V1_0_R8_C19.zip
GHSL_POPULATION_2030_URL=https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_POP_GLOBE_R2023A/GHS_POP_E2030_GLOBE_R2023A_54009_100/V1-0/tiles/GHS_POP_E2030_GLOBE_R2023A_54009_100_V1_0_R8_C19.zip
# Official GHSL 100 m Mollweide tile R8_C19 covers the full FCT AOI.
GHSL_BUILT_CURRENT_URL=https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_BUILT_S_GLOBE_R2023A/GHS_BUILT_S_E2025_GLOBE_R2023A_54009_100/V1-0/tiles/GHS_BUILT_S_E2025_GLOBE_R2023A_54009_100_V1_0_R8_C19.zip
GHSL_BUILT_2030_URL=https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_BUILT_S_GLOBE_R2023A/GHS_BUILT_S_E2030_GLOBE_R2023A_54009_100/V1-0/tiles/GHS_BUILT_S_E2030_GLOBE_R2023A_54009_100_V1_0_R8_C19.zip

# Comma-separated official structured JSON/CSV exports only. HTML pages and
# unverified proposed/construction map features are deliberately rejected.
OFFICIAL_PROJECTS_FEED_URLS=

# ---- Market open-data fallback (CC BY 4.0; area-centroid listings) ----
MARKET_SOURCE_URL=https://huggingface.co/datasets/ayookuns/abuja-housing-prices-v1/resolve/main/groundwork_abuja_housing_v1.csv

# ---- Google Earth Engine (primary for non-flood environmental domains) ----
# Service-account auth. GEE_SERVICE_ACCOUNT_KEY may be a path to the JSON key
# file OR the JSON content itself. Put real values in your local .env only.
GEE_SERVICE_ACCOUNT_EMAIL=aia-etl@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY=/run/secrets/gee-key.json
# Cloud project registered for Earth Engine; parsed from the SA email when unset.
GEE_PROJECT=

# ---- Auth (JWT) ----
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30

# ---- CORS (frontend origin) ----
CORS_ORIGINS=http://localhost:5174

# ---- Web map 3D sources (public, no access token required) ----
# The default transition is a lightweight pitched view; buildings appear from
# zoom 15. Terrain is optional because DEM tiles cost substantially more GPU,
# network, and memory on lower-powered devices.
VITE_3D_TERRAIN_ENABLED=false
# Override these TileJSON endpoints when deploying an approved/self-hosted service.
VITE_TERRAIN_TILEJSON_URL=https://tiles.mapterhorn.com/tilejson.json
VITE_TERRAIN_ENCODING=terrarium
VITE_TERRAIN_TILE_SIZE=512
VITE_BUILDINGS_TILEJSON_URL=https://tiles.openfreemap.org/planet
