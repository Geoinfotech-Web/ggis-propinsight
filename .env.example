# ============================================================
# GGIS PropInsight (AIA) — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- API app ----
AIA_ENV=dev
AIA_API_PORT=8000
AIA_LOG_LEVEL=INFO

# ---- PostGIS ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=propinsight
POSTGRES_USER=aia
POSTGRES_PASSWORD=change-me-in-local-env
# SQLAlchemy async URL (built from the above by config.py; override only if needed)
# DATABASE_URL=postgresql+asyncpg://aia:change-me@db:5432/propinsight

# ---- Redis (cache + Celery broker) ----
REDIS_URL=redis://redis:6379/0

# ---- GGIS Flood Watch API integration (Section 5, TDD) ----
# Base URL of the GGIS Flood Watch service. Use the mock for local dev:
GGIS_FLOOD_BASE_URL=http://mock-ggis:9100
# Service-to-service credentials (HMAC request signing over TLS).
# The real API key is READY — put it in your local .env, not here.
GGIS_FLOOD_API_KEY=replace-with-real-key-in-local-env
GGIS_FLOOD_HMAC_SECRET=replace-with-real-hmac-secret-in-local-env
# Contractual latency budget (ms) before we treat GGIS as degraded (TDD §10)
GGIS_FLOOD_TIMEOUT_MS=800

# ---- Auth (JWT) ----
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30

# ---- CORS (frontend origin) ----
CORS_ORIGINS=http://localhost:5173
